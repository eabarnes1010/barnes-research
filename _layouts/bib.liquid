---
---
{%- comment -%}
  LOCAL OVERRIDE of al_folio_core/_layouts/bib.liquid (gem v1.0.11).
  Barnes-lab changes vs upstream:
    1. Highlight ALL group members (current + former, from _data/members.yml) as
       authors via class "author-group" — not only the site owner.
    2. Add a "Cite" button that copies a plain-text citation (not the BibTeX).
  Re-check against the gem template after any al_folio_core upgrade, and run
  `bundle exec al-folio upgrade overrides audit` then commit .al-folio-overrides.yml.
{%- endcomment -%}
<div class="row">
  {%- comment -%} Barnes-lab: venue/thumbnail left column removed — publications render as a single full-width column. Status (Submitted/Preprint) now lives under the title in the main column below. {%- endcomment -%}
  <!-- Entry bib key -->
  {%- comment -%} Barnes-lab: `group_led = {true}` marks a paper written independently by group members
  (Barnes not an author). Emits a stable data-authorship hook so tooling (e.g. the CV diff) can exclude
  these by rule instead of by eye. {%- endcomment -%}
  <div id="{{ entry.key }}" class="col-sm-12"{% if entry.group_led %} data-authorship="group-led"{% endif %}>
    <!-- Title -->
    <div class="title">{{ entry.title }}</div>

    {%- comment -%} Barnes-lab: build venue+year (periodical) up front so it can be merged onto the author line for a compact two-line entry. {%- endcomment -%}
    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
    {% if entry.type == 'article' %}
      {% capture entrytype %}<em>{{ entry.journal }}</em>{% endcapture %}
    {% elsif proceedings contains entry.type %}
      {% capture entrytype %}<em>In {{ entry.booktitle }}</em>{% endcapture %}
    {% elsif thesis contains entry.type %}
      {% capture entrytype %}<em>{{ entry.school }}</em>{% endcapture %}
    {% else %}
      {% capture entrytype %}{% endcapture %}
    {% endif %}
    {%- comment -%} Barnes-lab: the bib `month` field is deliberately never printed — the date shown is the year alone. {%- endcomment -%}
    {% assign entryyear = '' %}
    {% if entry.year %}
      {% capture entryyear %}{{ " " }}{{ entry.year }}{% endcapture %}
    {% endif %}
    {% if entry.location %}
      {% capture entrytype %}{{ entrytype }}{{ ", " }}{{ entry.location }}{% endcapture %}
    {% endif -%}
    {% if entry.additional_info %}
      {% capture entrytype %}{{ entrytype }}{{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' }}{% endcapture %}
    {% endif %}
    {% capture hook_exists %}{% file_exists _includes/hook/bib.liquid %}{% endcapture %}
    {% if hook_exists == 'true' %}
      {% include hook/bib.liquid %}
    {% endif %}
    {% assign entrytype_text = entrytype | strip_html | strip %}
    {%- comment -%} Barnes-lab: Chicago 17th ordering — the date is its own element placed right after the authors, ahead of the venue. {%- endcomment -%}
    {% capture pubdate %}{{ entryyear }}{% endcapture %}
    {% capture periodical %}{{ entrytype }}{% endcapture %}

    <!-- Author -->
    <div class="author">
      {% assign author_array_size = entry.author_array | size %}

      {% assign author_array_limit = author_array_size %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign author_array_limit = site.max_author_limit %}
        {%- comment -%}
          Barnes-lab: never hide a group member behind "and N more authors". If any
          author in the would-be-hidden tail is a current/former member, show all.
        {%- endcomment -%}
        {%- for author in entry.author_array offset: author_array_limit -%}
          {%- assign tail_last = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' | downcase | remove_accents -%}
          {%- assign tail_initial = author.first | strip | slice: 0 | downcase -%}
          {%- assign tail_members = site.data.members.current | concat: site.data.members.former -%}
          {%- for grp in tail_members -%}
            {%- assign grp_parts = grp.name | split: ' ' -%}
            {%- assign grp_last = grp_parts | last | downcase | remove_accents -%}
            {%- assign grp_first_initial = grp_parts | first | slice: 0 | downcase -%}
            {%- if grp_last == tail_last and grp_first_initial == tail_initial -%}
              {%- assign author_array_limit = author_array_size -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if author_array_limit == author_array_size -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {% endif %}

      {%- for author in entry.author_array limit: author_array_limit -%}
        {% assign author_is_self = false %}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {% if site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign author_is_self = true %}
          {% endif %}
        {%- endif -%}
        {% assign coauthor_url = null %}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {% if site.data.coauthors[clean_last_name] %}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {% if coauthor.firstname contains author.first %}
              {%- assign coauthor_url = coauthor.url -%}
              {% break %}
            {%- endif -%}
          {% endfor %}
        {%- endif -%}

        {%- comment -%} Barnes-lab: flag any current/former group member (match last name + first initial). {%- endcomment -%}
        {%- assign author_is_group = author_is_self -%}
        {%- assign author_first_initial = author.first | strip | slice: 0 | downcase -%}
        {%- unless author_is_group -%}
          {%- for grp in site.data.members.current -%}
            {%- assign grp_parts = grp.name | split: ' ' -%}
            {%- assign grp_last = grp_parts | last | downcase | remove_accents -%}
            {%- assign grp_first_initial = grp_parts | first | slice: 0 | downcase -%}
            {%- if grp_last == clean_last_name and grp_first_initial == author_first_initial -%}
              {%- assign author_is_group = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}
        {%- unless author_is_group -%}
          {%- for grp in site.data.members.former -%}
            {%- assign grp_parts = grp.name | split: ' ' -%}
            {%- assign grp_last = grp_parts | last | downcase | remove_accents -%}
            {%- assign grp_first_initial = grp_parts | first | slice: 0 | downcase -%}
            {%- if grp_last == clean_last_name and grp_first_initial == author_first_initial -%}
              {%- assign author_is_group = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        {%- if forloop.length > 1 -%}
          {%- comment -%} Barnes-lab: always a comma before the next author — the inverted first author already ends in a given name, so "Barnes, Elizabeth A. and X" would misread. {%- endcomment -%}
          {% if forloop.first == false %}, {% endif %}
          {%- if forloop.last and author_array_limit == author_array_size %}and {% endif -%}
        {% endif %}
        {%- comment -%} Barnes-lab: Chicago 17th bibliography — only the FIRST author is inverted to "Last, First"; every other author stays "First Last". {%- endcomment -%}
        {%- capture author_display -%}
          {%- if forloop.first -%}
            {{- author_last_html }}, {{ author.first -}}
          {%- else -%}
            {{- author.first }} {{ author_last_html -}}
          {%- endif -%}
        {%- endcapture -%}
        {%- if author_is_group -%}
          {%- if coauthor_url -%}
            <a class="author-group" href="{{ coauthor_url }}">{{ author_display }}</a>
          {%- else -%}
            <span class="author-group">{{ author_display }}</span>
          {%- endif -%}
        {%- else -%}
          {%- if coauthor_url -%}
            <a href="{{ coauthor_url }}">{{ author_display }}</a>
          {%- else -%}
            {{- author_display -}}
          {% endif %}
        {%- endif -%}
      {% endfor %}
      {%- assign more_authors = author_array_size | minus: author_array_limit -%}

      {%- assign more_authors_hide = more_authors | append: ' more author' -%}
      {% if more_authors > 0 %}
        {%- if more_authors > 1 -%}
          {% assign more_authors_hide = more_authors_hide | append: 's' %}
        {%- endif -%}
        {% assign more_authors_show = '' %}
        {%- for author in entry.author_array offset: author_array_limit -%}
          {% assign more_authors_show = more_authors_show | append: author.first | append: ' ' | append: author.last %}
          {% unless forloop.last %}
            {% assign more_authors_show = more_authors_show | append: ', ' %}
          {% endunless %}
        {%- endfor -%}
        {%- assign more_authors_show = more_authors_show | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        , and
        <span
          class="more-authors"
          title="click to view {{ more_authors_hide }}"
          onclick="
              var element = this;
              element.setAttribute('title', '');
              var more_authors_text = element.textContent == '{{ more_authors_hide }}' ? '{{ more_authors_show }}' : '{{ more_authors_hide }}';
              var cursorPosition = 0;
              var textAdder = setInterval(function(){
                element.innerHTML = more_authors_text.substring(0, cursorPosition + 1);
                if (++cursorPosition == more_authors_text.length){
                  clearInterval(textAdder);
                }
            }, '{{ site.more_authors_animation_delay }}');
          "
        >
          {{- more_authors_hide -}}
        </span>
      {%- endif -%}
      {%- if entry.annotation -%}
        <i
          class="fa-solid fa-circle-info ml-1"
          data-toggle="popover"
          data-placement="top"
          data-html="true"
          data-content="{{ entry.annotation | escape }}"
        >
        </i>
      {%- endif -%}
      {%- comment -%} Barnes-lab: year then venue on the same line as the authors (Chicago 17th author-date order, compact), with the not-yet-published (no DOI) status appended INLINE at the end so it can't be skimmed past as published. {%- endcomment -%}
      {%- assign pubdate_text = pubdate | strip -%}
      {%- assign periodical_text = periodical | strip -%}
      {%- if pubdate_text != '' -%}
        . <span class="periodical">{{ pubdate_text }}</span>
      {%- endif -%}
      {%- if periodical_text != '' -%}
        . <span class="periodical">{{ periodical_text }}</span>
      {%- endif -%}
      {%- comment -%} Barnes-lab: accepted but not yet assigned a DOI. `in_press = {true}` prints "In Press" instead of the Submitted/Preprint flag; drop the field and add the `doi` once it is issued. {%- endcomment -%}
      {%- if entry.in_press -%}
        {% if periodical_text != '' or pubdate_text != '' %}
          <span class="pub-status">&middot;&nbsp;In&nbsp;Press</span>
        {%- else %}
          <span class="pub-status">In&nbsp;Press</span>
        {%- endif %}
      {%- endif -%}
      {%- comment -%} Barnes-lab: flag as not-yet-published only when there is NO link to a published version (doi/html/url/website) and the paper is not already flagged in press. Preprints (which carry only a `preprint` link) still flag; a published paper with no DOI but an article URL — e.g. an Eos opinion piece — does not. Set `hide_status = {true}` on an entry to force-hide the flag (e.g. a permanent preprint that will never be published) while keeping its Preprint button. {%- endcomment -%}
      {%- unless entry.doi or entry.html or entry.url or entry.website or entry.hide_status or entry.in_press -%}
        {% if periodical_text != '' or pubdate_text != '' %}
          <span class="pub-status">&middot;&nbsp;Submitted&nbsp;/&nbsp;Preprint</span>
        {%- else %}
          <span class="pub-status">Submitted&nbsp;/&nbsp;Preprint</span>
        {%- endif %}
      {%- endunless -%}
      {%- comment -%} Barnes-lab: group-led badge, inline after the venue/status. Deliberately unexplained on the page — no legend. {%- endcomment -%}
      {%- if entry.group_led -%}
        <span class="pub-authorship">group-led</span>
      {%- endif -%}
    </div>

    {%- comment -%} Barnes-lab: note line kept ONLY for non-peer-reviewed work (workshop papers, reports, book chapters, etc.); in-press is treated as published. {%- endcomment -%}
    {%- assign note_text = entry.note | strip -%}
    {%- if note_text contains 'non-refereed' -%}
      <div class="periodical pub-note">{{ note_text }}</div>
    {%- endif -%}

    {%- comment -%}
      Barnes-lab: build a plain-text Chicago 17th author-date citation for the "Cite" copy button:
      Last, First, First Last, and First Last. Year. "Title." Venue Volume (Issue): Pages. https://doi.org/...
      Every element after the authors is optional and is simply omitted when the bib entry lacks it.
      A bibtex "and others" arrives as an author named `others`; render that as "et al." instead.
    {%- endcomment -%}
    {%- capture cite_authors -%}
      {%- for author in entry.author_array -%}
        {%- assign cite_last = author.last | strip -%}
        {%- if cite_last == 'others' -%}
          , et al.
        {%- else -%}
          {%- unless forloop.first -%}, {% if forloop.last %}and {% endif %}{%- endunless -%}
          {%- if forloop.first -%}{{ cite_last }}, {{ author.first | strip }}{%- else -%}{{ author.first | strip }} {{ cite_last }}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign cite_authors = cite_authors | regex_replace: '[*∗†‡§¶‖&^]', '' | strip -%}
    {%- capture cite_venue -%}
      {%- if entry.journal -%}{{ entry.journal }}{%- elsif entry.booktitle -%}In {{ entry.booktitle }}{%- elsif entry.school -%}{{ entry.school }}{%- endif -%}
    {%- endcapture -%}
    {%- assign cite_venue = cite_venue | strip -%}
    {%- comment -%} Volume and (issue) only make sense hanging off a venue, so build them together. Page numbers are deliberately never printed. {%- endcomment -%}
    {%- capture cite_source -%}
      {%- if cite_venue != '' -%}
        {{ cite_venue }}
        {%- if entry.volume %} {{ entry.volume | strip }}{% endif -%}
        {%- if entry.number %} ({{ entry.number | strip }}){% endif -%}
        .
      {%- endif -%}
    {%- endcapture -%}
    {%- comment -%} A trailing "et al." already carries its own period, and a title ending in ? or ! keeps that mark instead of taking a period. {%- endcomment -%}
    {%- assign cite_authors_tail = cite_authors | slice: -1 -%}
    {%- assign cite_title = entry.title | strip -%}
    {%- assign cite_title_tail = cite_title | slice: -1 -%}
    {%- capture cite_text -%}
      {{- cite_authors -}}
      {%- if cite_authors != '' and cite_authors_tail != '.' %}.{% endif -%}
      {%- if entry.year %} {{ entry.year }}.{% endif %} "{{ cite_title }}
      {%- unless cite_title_tail == '?' or cite_title_tail == '!' %}.{% endunless %}"
      {%- if cite_source != '' %} {{ cite_source | strip }}{% endif -%}
      {%- if entry.doi %} https://doi.org/{{ entry.doi }}.{% elsif entry.url %} {{ entry.url }}.{% endif -%}
    {%- endcapture -%}

    <!-- Links/Buttons -->
    <div class="links">
      {% if entry.award %}
        <a class="award btn btn-sm z-depth-0" role="button">
          {%- if entry.award_name %}{{ entry.award_name }}{% else %}Awarded{% endif -%}
        </a>
      {% endif %}
      {% if entry.abstract %}
        <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
      {% endif %}
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm z-depth-0" role="button">DOI</a>
      {% endif %}
      {%- comment -%} Barnes-lab: preprint link (external URL or local PDF under /assets/pdf/). {%- endcomment -%}
      {% if entry.preprint %}
        {% if entry.preprint contains '://' %}
          <a href="{{ entry.preprint }}" class="btn btn-sm z-depth-0" role="button">Preprint</a>
        {% else %}
          <a href="{{ entry.preprint | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Preprint</a>
        {% endif %}
      {% endif %}
      {% if entry.arxiv %}
        <a href="http://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0" role="button">arXiv</a>
      {% endif %}
      {% if entry.hal %}
        <a href="https://hal.science/{{ entry.hal }}" class="btn btn-sm z-depth-0" role="button">HAL</a>
      {% endif %}
      {%- comment -%} Barnes-lab: the "Bib" button and its hidden BibTeX block are deliberately removed — "Cite" copies a plain-text citation instead. `bibtex_show` in papers.bib is now inert. {%- endcomment -%}
      <a class="citation-copy btn btn-sm z-depth-0" role="button" data-citation="{{ cite_text | strip | escape }}">Cite</a>
      {% if entry.html %}
        {% if entry.html contains '://' %}
          <a href="{{ entry.html }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
        {% else %}
          <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
        {% endif %}
      {% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.supp %}
        {% if entry.supp contains '://' %}
          <a href="{{ entry.supp }}" class="btn btn-sm z-depth-0" role="button">Supp</a>
        {% else %}
          <a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Supp</a>
        {% endif %}
      {% endif %}
      {% if entry.video and site.enable_video_embedding %}
        <a class="abstract btn btn-sm z-depth-0" role="button">Video</a>
      {% elsif entry.video %}
        <a href="{{ entry.video }}" class="btn btn-sm z-depth-0" role="button">Video</a>
      {% endif %}
      {% if entry.blog %}
        <a href="{{ entry.blog }}" class="btn btn-sm z-depth-0" role="button">Blog</a>
      {% endif %}
      {% if entry.code %}
        <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
      {% endif %}
      {% if entry.poster %}
        {% if entry.poster contains '://' %}
          <a href="{{ entry.poster }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% else %}
          <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% endif %}
      {% endif %}
      {% if entry.slides %}
        {% if entry.slides contains '://' %}
          <a href="{{ entry.slides }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% else %}
          <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% endif %}
      {% endif %}
      {% if entry.website %}
        <a href="{{ entry.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
      {% endif %}
    </div>
    {% if site.enable_publication_badges %}
      {% assign entry_has_altmetric_badge = false %}
      {% if entry.altmetric and entry.altmetric != 'false' %}
        {% assign entry_has_altmetric_badge = true %}
      {% endif %}

      {% assign entry_has_dimensions_badge = false %}
      {% if entry.dimensions and entry.dimensions != 'false' %}
        {% assign entry_has_dimensions_badge = true %}
      {% endif %}

      {% assign entry_has_google_scholar_badge = false %}
      {% if entry.google_scholar_id %}
        {% assign entry_has_google_scholar_badge = true %}
      {% endif %}

      {% assign entry_has_inspirehep_badge = false %}
      {% if entry.inspirehep_id %}
        {% assign entry_has_inspirehep_badge = true %}
      {% endif %}
      {% if entry_has_altmetric_badge or entry_has_dimensions_badge or entry_has_google_scholar_badge or entry_has_inspirehep_badge %}
        <div class="badges">
          {% if site.enable_publication_badges.altmetric and entry_has_altmetric_badge %}
            <span
              class="altmetric-embed"
              data-badge-type="2"
              data-badge-popover="right"
              {% if entry.altmetric != blank and entry.altmetric != 'true' %}
                data-altmetric-id="{{ entry.altmetric }}"
              {% elsif entry.arxiv %}
                data-arxiv-id="{{ entry.arxiv }}"
              {% elsif entry.eprint %}
                data-arxiv-id="{{ entry.eprint }}"
              {% elsif entry.doi %}
                data-doi="{{ entry.doi }}"
              {% elsif entry.pmid %}
                data-pmid="{{ entry.pmid }}"
              {% elsif entry.isbn %}
                data-isbn="{{ entry.isbn }}"
              {% endif %}
            ></span>
          {% endif %}
          {% if site.enable_publication_badges.dimensions and entry_has_dimensions_badge %}
            <span
              class="__dimensions_badge_embed__"
              {% if entry.dimensions != blank and entry.dimensions != 'true' %}
                data-id="{{ entry.dimensions }}"
              {% elsif entry.doi %}
                data-doi="{{ entry.doi }}"
              {% else %}
                data-pmid="{{ entry.pmid }}"
              {% endif %}
              data-style="small_rectangle"
              data-legend="hover-right"
              style="margin-bottom: 3px;"
            ></span>
          {% endif %}
          {% if site.enable_publication_badges.google_scholar and entry_has_google_scholar_badge %}
            <a
              href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user={{ site.data.socials.scholar_userid }}&citation_for_view={{ site.data.socials.scholar_userid }}:{{ entry.google_scholar_id }}"
              aria-label="Google Scholar link"
              role="button"
            >
              {% assign citation_count = 0 %}
              {% assign scholar_id_key = site.scholar_userid | append: ':' | append: entry.google_scholar_id %}
              {% assign publication_key = entry.google_scholar_id %}

              {% if site.data.citations.papers[scholar_id_key] %}
                {% assign citation_count = site.data.citations.papers[scholar_id_key].citations %}
              {% elsif site.data.citations.papers[publication_key] %}
                {% assign citation_count = site.data.citations.papers[publication_key].citations %}
              {% else %}
                {% for paper in site.data.citations.papers %}
                  {% assign paper_key = paper[0] %}
                  {% if paper_key contains entry.google_scholar_id %}
                    {% assign citation_count = paper[1].citations %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              <img
                src="https://img.shields.io/badge/scholar-{{ citation_count }}-4285F4?logo=googlescholar&labelColor=beige"
                alt="{{ citation_count }} Google Scholar citations"
              >
            </a>
          {% endif %}
          {% if site.enable_publication_badges.inspirehep and entry_has_inspirehep_badge %}
            <a
              href="https://inspirehep.net/literature/{{ entry.inspirehep_id }}"
              aria-label="Inspirehep link"
              role="button"
            >
              <img
                src="https://img.shields.io/badge/inspire-{% inspirehep_citations entry.inspirehep_id %}-001628?logo=inspire&logoColor=001628&labelColor=beige"
                alt="{% inspirehep_citations entry.inspirehep_id %} InspireHEP citations"
              >
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    {% if entry.award %}
      <!-- Hidden Award block -->
      <div class="award hidden d-print-inline">
        <p>{{ entry.award | markdownify }}</p>
      </div>
    {% endif %}

    {% if entry.abstract %}
      <!-- Hidden abstract block -->
      <div class="abstract hidden">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}

    {% if entry.video and site.enable_video_embedding %}
      <!-- Hidden video block -->
      <div class="abstract hidden">
        <div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div>
      </div>
    {% endif %}
  </div>
</div>
